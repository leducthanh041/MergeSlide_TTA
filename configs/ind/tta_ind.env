: "${TTA_M:=8}"
: "${TTA_K_SUB:=300}"
: "${TTA_N_STEPS:=5}"
: "${TTA_ENTROPY_LOSS_WEIGHT:=1.0}"
: "${TTA_PARAM_SCOPE:=ln_only}"
: "${TTA_SELECT_MODE:=intersection}"
: "${TTA_NAIVE_USE_TASK_ENTROPY:=1}"
: "${TTA_USE_DAPC:=1}"
: "${TTA_LR:=0.0002}"
: "${TTA_L2_ANCHOR_BETA:=0.5}"
: "${TTA_TOP_RATIO:=0.75}"
: "${TTA_ENTROPY_THRESHOLD:=0.3}"
: "${TTA_EMA_ALPHA:=0.99}"
: "${TTA_DAPC_LOSS_WEIGHT:=1.0}"
: "${TTA_DAPC_TAU_ANCHOR:=0.5}"
: "${TTA_DAPC_BETA:=1.0}"

: "${TTA_ALPHA:=0.75}"
: "${TTA_GAMMA:=1.0}"
: "${TTA_EMA_ALPHA_PROMPT:=0.999}"
: "${TTA_DELTA_MARGIN:=0.3}"
: "${TTA_TP_ANCHOR_BETA:=0.0}"
: "${TTA_GAMMA_MARGIN:=0.0}"
: "${TTA_TAU_TASK:=0.5}"

: "${TTA_NAIVE_ALPHA:=1.0}"
: "${TTA_NAIVE_GAMMA:=0.0}"
: "${TTA_NAIVE_DELTA_MARGIN:=0.05}"
: "${TTA_NAIVE_TP_ANCHOR_BETA:=0.7}"
: "${TTA_NAIVE_GAMMA_MARGIN:=0.05}"
: "${TTA_NAIVE_TAU_TASK:=0.9}"
: "${TTA_NAIVE_USE_DAPC:=0}"
: "${TTA_NAIVE_NO_TEACHER:=1}"
